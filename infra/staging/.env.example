# Mẫu secret cho STAGING. Copy thành infra/staging/.env (đã bị .gitignore chặn) và điền giá trị riêng,
# KHÔNG dùng lại mật khẩu/khóa của DEV. Khóa JWT riêng đặt ở infra/staging/secrets/ (xem docs/34 §3).
STAGING_DB_PASSWORD=
# Khóa nội bộ backend <-> ai-service (chuỗi ngẫu nhiên dài).
AI_INTERNAL_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tạo admin staging ở lần khởi động đầu; có rồi thì có thể để trống.
ADMIN_EMAIL=
ADMIN_PASSWORD=
