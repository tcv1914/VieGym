GEMINI_API_KEY=
# Dùng model có phiên bản cố định; alias "-latest" có thể đổi model hoặc quá tải (503, 2026-11-10).
GEMINI_MODEL=gemini-2.5-flash
# Khóa nội bộ backend <-> ai-service; backend đặt cùng giá trị qua biến môi trường AI_INTERNAL_KEY.
AI_INTERNAL_KEY=
# Tùy chọn
AI_DEADLINE_SECONDS=25
AI_MAX_OUTPUT_TOKENS=2048
